rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection testing doc
    match /test/{testId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // User profile document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Business Profile and settings
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // User's private invoices
      match /invoices/{invoiceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(invoiceId);
        allow delete: if isOwner(userId);
      }

      // User's private drafts
      match /drafts/{draftId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(draftId);
        allow delete: if isOwner(userId);
      }

      // User's private customers
      match /customers/{customerId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(customerId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
